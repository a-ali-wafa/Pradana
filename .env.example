# PRADANA — contoh konfigurasi environment
# Salin jadi `.env`, jalankan `php artisan key:generate`, lalu isi bagian
# DATABASE dan GOOGLE DRIVE. Jangan pernah commit `.env` yang sebenarnya
# (sudah masuk .gitignore).

APP_NAME=PRADANA
APP_ENV=local
APP_KEY=
# APP_DEBUG=true HANYA untuk pengembangan. Di server kantor: false (S12).
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Zona waktu aplikasi. Semua tanggal yang dilihat petugas dihitung dari now():
# nomor Berita Acara (romawi + tahun), tanggal pelaksanaannya, "bulan ini" di
# dashboard, dan periode default /laporan. Bawaan Asia/Jakarta (WIB). Kantor di
# WITA/WIT ganti ke Asia/Makassar / Asia/Jayapura — jangan dibiarkan UTC, karena
# setiap kejadian antara 00:00 dan 07:00 waktu setempat akan tercatat sebagai
# hari SEBELUMNYA (Berita Acara tertanggal 31 Desember untuk persetujuan yang
# terjadi 1 Januari 02:30 WIB).
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MariaDB bawaan XAMPP untuk pengembangan, S2) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pradana
DB_USERNAME=root
DB_PASSWORD=

# Database terpisah untuk tes yang butuh MariaDB sungguhan (NomorSuratKeluarTest).
# Buat sekali: CREATE DATABASE pradana_test; tanpa ini kelas tes itu gagal,
# tapi suite lain (SQLite in-memory) tetap jalan.
DB_TEST_DATABASE=pradana_test

# --- Sesi & cache ---
# `file` cukup untuk satu komputer kantor (keputusan S10 DIBATALKAN 4 Okt 2026):
# lock file sudah atomik, dan `database` cuma menambah round-trip tiap request
# + mengunci login saat DB bermasalah. Tabel sessions/cache sengaja tidak dibuat.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file

# --- Header keamanan (TandaiArsipPrivat, 9 Okt 2026) ---
# Arsip kantor tidak boleh ter-index; itu selalu berlaku dan TIDAK bisa
# dimatikan. Sakelar ini hanya untuk Content-Security-Policy, dipakai saat
# mendiagnosis layout yang rusak karena kebijakan konten. Biarkan true.
SECURITY_CSP=true

# Plafon jumlah baris satu Buku Agenda PDF (dibaca config/laporan.php). Dokumen
# ini dibuat dalam satu permintaan HTTP — tidak ada queue (L-02) — dan 1.000 baris
# terukur butuh 8,4 detik + 52 MB di MariaDB. Di shared hosting kantor (K1=a)
# `max_execution_time`/`memory_limit` tidak bisa dinaikkan dari kode, jadi periode
# yang melewati batas ini DITOLAK dengan pesan "persempit periodenya", bukan
# mati di tengah render. Naikkan hanya kalau server sudah diukur; 0 = tolak semua.
AGENDA_BATAS_BARIS=2000

# --- Cadangan database (arsip:backup-db, dijadwalkan harian 02:10) ---
# Path biner mysqldump. Di shared hosting biasanya sudah ada di PATH, jadi cukup
# `mysqldump` dan baris ini dibiarkan kosong/komentar. Di laptop XAMPP:
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
# Perintahnya menolak jalan tanpa biner yang bisa dieksekusi — tidak pernah
# mengaku "cadangan dibuat" sambil menulis berkas kosong.
MYSQLDUMP_PATH=mysqldump
# Folder tujuan dump. WAJIB di luar public/ (isinya struktur + isi arsip kantor);
# default-nya storage/app/private/db-backup, tidak perlu diubah kecuali server
# kantor punya disk kedua.
# BACKUP_DIR=
# Berapa hari dump dipertahankan; yang lebih tua dibuang, HANYA berkas berpola
# prd-YYYY-MM-DD-HHMMSS.sql (dump manual petugas tidak pernah disentuh).
BACKUP_SIMPAN_HARI=30
# Matikan kalau hosting menolak `--routines`/`--events` dengan "Access denied"
# (butuh privilege di luar database kantor). Skema PRADANA hari ini tidak punya
# prosedur maupun event, jadi cadangan tetap lengkap untuk yang ada.
BACKUP_PROSEDUR=true
BACKUP_EVENT=true

# Queue sengaja sync: upload & log dikerjakan langsung tanpa worker
# (L-02 — hosting kantor tidak menjalankan queue:work).
QUEUE_CONNECTION=sync

# Logo instansi disimpan di disk public (C7); berkas arsip di disk `arsip`
# (storage/app/private, L-01) — tidak perlu diatur di sini.
FILESYSTEM_DISK=public

# --- Backup Google Drive (L-01: Drive itu CADANGAN, berkas utama di disk lokal) ---
# Path relatif terhadap folder project. File JSON-nya TIDAK boleh di-commit.
GOOGLE_DRIVE_CREDENTIALS_PATH=storage/app/google/service-account.json
# ID folder Drive yang sudah di-share ke email Service Account (Bagian 7 AGENTS.md).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Hanya untuk pengembangan ---
# PIN yang dipakai DevSeeder untuk akun contoh. Tidak dipakai di produksi;
# `php artisan arsip:akun-pertama` selalu meminta PIN sendiri di terminal.
DEV_PIN=12345678
