			identifier: property.notFound
			count: 1
			path: app/Models/Lampiran.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$nomor_surat\.$#'
			identifier: property.notFound
			count: 3
			path: app/Observers/DrafKontenSuratKeluarObserver.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:hapusBerkasFisik\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Observers/SuratKeluarObserver.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:hapusBerkasFisik\(\)\.$#'
			identifier: method.notFound
			count: 1
