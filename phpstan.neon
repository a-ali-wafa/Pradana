includes:
    # 9 Okt 2026: paketnya pindah nama — `nunomaduro/larastan` sudah di-mark
    # "abandoned" oleh composer dan diganti `larastan/larastan` (versi 3.13.0).
    - vendor/larastan/larastan/extension.neon
    # Entri hasil `--generate-baseline`, dibaca satu-satu, bukan dibungkam massal.
    # Terakhir disentuh 9 Okt (Fase 7): 4 `catch (QueryException)` controller
    # klasifikasi menyatu jadi SATU di trait MengelolaKlasifikasi — PHPStan tidak
    # bisa melihat bahwa PDO melempar constraint violation saat runtime, padahal
    # justru itu jalur yang dipakai surat yang masih memakai sebuah kode.
    # Regenerasi kalau file-file itu berubah: vendor/bin/phpstan --generate-baseline
    - phpstan-baseline.neon

# L-24 (Q2=a): analisis statis. Level 5 dipilih sebagai titik mulai yang masih
# masuk akal untuk kode yang ditulis cepat sepanjang Sep-Okt 2026; Naikkan ke
# 6/7 setelah temuan di level ini habis, jangan langsung 8 (baseline-nya akan
# jadi kuburan).
parameters:
    paths:
        - app
        - database
        - routes
    level: 5
    treatPhpDocTypesAsCertain: false
