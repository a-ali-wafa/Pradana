# ─────────────────────────────────────────────────────────────────────────────
# Kompresi + header cache untuk aset statis.
#
# Ditambah sesudah pengukuran ukuran aset (12 Okt 2026):
# halaman pertama memuat 641 KB aset dan Apache mengirimnya mentah-mentah, lalu
# browser masih harus menanya ulang setiap navigasi.
#
# Kenapa satu tahun aman: SETIAP URL aset di layout membawa `?v=<versi>`
# (contoh: vendor/bootstrap/bootstrap.min.css?v=5.3.3). Ganti versi = URL baru,
# jadi browser tidak pernah memegang berkas basi. Berkas yang TIDAK boleh ikut
# disimpan adalah text/html — itu sebabnya ada aturan 0 detik di bawah.
#
# PENTING untuk yang berikutnya menyentuh berkas ini: satu baris saja yang tidak
# dikenali Apache membuat SELURUH situs menjawab 500 (bukan "fiturnya mati").
# `php artisan serve` tidak membaca .htaccess sama sekali, jadi bug seperti ini
# tidak akan pernah kelihatan di laptop kecuali diuji di Apache sungguhan --
# dan dua di antaranya justru ketemu saat diuji 12 Okt (lihat komentar di blok
# mod_filter di bawah). Uji ulang dengan XAMPP Apache sebelum mengubah isinya.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_filter.c>
    <IfModule mod_deflate.c>
        # `AddOutputFilterByType` dimiliki mod_filter, BUKAN mod_deflate. Kalau blok
        # ini hanya dijaga <IfModule mod_deflate.c> dan mod_filter tidak terpasang,
        # Apache menjawab "Invalid command 'AddOutputFilterByType'" dan -- sama seperti
        # kesalahan lain di .htaccess -- SEMUA request jadi 500, bukan sekadar
        # "kompresi mati". Terjadi di uji Apache 12 Okt; karena itu dijaga dua lapis.
        AddOutputFilterByType DEFLATE text/html
        AddOutputFilterByType DEFLATE text/plain
        AddOutputFilterByType DEFLATE text/css
        AddOutputFilterByType DEFLATE text/javascript
        AddOutputFilterByType DEFLATE application/javascript
        AddOutputFilterByType DEFLATE application/json
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_mime.c>
    # woff2 sudah dikompresi Brotli di dalam filenya; deflate lagi cuma membakar CPU
    # hosting tanpa menghemat satu byte pun. Karena itu woff2 TIDAK masuk daftar DEFLATE.
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Kompresi per-user tidak boleh dibagikan proxy yang salah memahami Vary.
    Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
